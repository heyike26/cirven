{
  "$defs": {
    "CompetitorObservation": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "OFFICIAL_CLAIM",
            "USER_TESTED",
            "INFERENCE",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_anchors": {
          "items": {
            "$ref": "#/$defs/QuestionAnchor"
          },
          "maxItems": 32,
          "title": "Source Anchors",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "text",
        "status"
      ],
      "title": "CompetitorObservation",
      "type": "object"
    },
    "DiagramEdge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Target",
          "type": "string"
        },
        "relation": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "source_anchors": {
          "items": {
            "$ref": "#/$defs/QuestionAnchor"
          },
          "maxItems": 32,
          "title": "Source Anchors",
          "type": "array"
        },
        "origin": {
          "default": "MODEL_SUGGESTION",
          "enum": [
            "USER_STATEMENT",
            "SOURCE_FACT",
            "MODEL_SUGGESTION"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "relation"
      ],
      "title": "DiagramEdge",
      "type": "object"
    },
    "DiagramNode": {
      "additionalProperties": false,
