          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 24000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "source_anchors": {
          "items": {
            "$ref": "#/$defs/QuestionAnchor"
          },
          "maxItems": 32,
          "title": "Source Anchors",
          "type": "array"
        },
        "origin": {
          "default": "MODEL_SUGGESTION",
          "enum": [
            "USER_STATEMENT",
            "SOURCE_FACT",
            "MODEL_SUGGESTION"
          ],
          "title": "Origin",
